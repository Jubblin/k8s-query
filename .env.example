# Git Repository Configuration
# Repository URL (e.g., github.com/username/repo.git)
K8S_GIT_REPO=

# Git credentials
K8S_GIT_USERNAME=
K8S_GIT_PASSWORD=

# Git branch (optional, defaults to 'main')
K8S_GIT_BRANCH=main

# Optional: Kubernetes Configuration
# If you want to use a different kubeconfig file location
# KUBECONFIG=/path/to/your/kubeconfig 